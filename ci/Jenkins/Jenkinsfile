// mario-app-build Jenkinsfile for building the Mario application Docker image and pushing to Docker Hub
pipeline {
    agent any

    // Define parameters for the build, including a required IMAGE_TAG for the Docker image version
    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to build and deploy (defaults to latest)')
    }

    // Define environment variables for Docker image name, credentials, and kubeconfig for deployment
    environment {
        DOCKER_IMAGE = "bus57790/mario"
        IMAGE_TAG = "${params.IMAGE_TAG}"
        build_version = "${params.IMAGE_TAG}"
        DOCKER_CREDS = 'dockerhub-credentials'
        KUBE_CONFIG = 'k8s-config-id'
    }

    stages {
        // Normalizes IMAGE_TAG so empty input still uses a safe default for first-time builds
        stage('Validate Parameters') {
            steps {
                script {
                    env.IMAGE_TAG = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : 'latest'
                    env.build_version = env.IMAGE_TAG
                }
            }
        }

        // Checkout the git repository in the feature branch to access deployment manifests
        stage('Checkout') {
            steps {
                git branch: 'feature/jenkins-integration', url: 'https://github.com/bus57790/k8s-mario.git'
            }
        }

        // Performs a security scan on the Docker image using Trivy, checking for vulnerabilities with HIGH and CRITICAL severity. The build will not fail if vulnerabilities are found, but they will be reported in the logs.
        stage('Security Scan (Trivy)') {
            steps {
                script {
                    sh 'trivy image --exit-code 1 --severity HIGH,CRITICAL ${DOCKER_IMAGE}:latest || true'
                }
            }
        }

        // Re-tags an existing Docker Hub image so this pipeline does not depend on a local Dockerfile
        stage('Tag & Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKER_CREDS) {
                        // Pull a known-safe source tag, then create and push the requested tag.
                        sh '''
                            set -e
                            docker pull ${DOCKER_IMAGE}:latest
                            docker tag ${DOCKER_IMAGE}:latest ${DOCKER_IMAGE}:${IMAGE_TAG}
                            docker push ${DOCKER_IMAGE}:${IMAGE_TAG}
                            docker push ${DOCKER_IMAGE}:latest
                        '''
                    }
                }
            }
        }

        // Updates the k8s deployment manifest with the new Docker image tag, commits the change to the feature branch, and pushes it back to GitHub using a personal access token for authentication. This allows the CD pipeline to deploy the new image version to Kubernetes.
        stage('Update Deployment File') {
            environment {
                GIT_REPO_NAME = "k8s-mario"
                GIT_USER_NAME = "bus57790"
            }
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config user.email "bus57790@hotmail.com"
                        git config user.name "bus57790"
                        sed -i "s|image: .*|image: ${DOCKER_IMAGE}:${build_version}|" k8s/deployment.yaml
                        git add k8s/deployment.yaml
                        git commit -m "Update deployment image to version ${build_version}"
                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:feature/jenkins-integration
                    '''
                }
            }
        }
    }

    // Post actions to clean up the workspace and print success/failure messages, as well as triggering the CD pipeline build for deployment if the build is successful
    post {
        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
        success {
            echo 'Mario application updated'
            // Triggering the mario-app-deployment build
            build job: 'mario-app-deployment'
        }
        failure {
            echo 'Mario build failed. Check logs for details.'
        }
    }
}

